# Read by docker compose only (it picks up a .env next to docker-compose.yml).
# The application's own settings live in backend/.env.
#
#   cp .env.example .env
#
# Only needed if something else already owns 5432 — a Homebrew or Postgres.app
# install, or another project's container. Check with:
#
#   lsof -nP -iTCP:5432 -sTCP:LISTEN
#
# If you change this, set the same value as DB_PORT in backend/.env.
POSTGRES_PORT=5432
