# Copy to .env and adjust. .env is gitignored; .env.example is the contract.

NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml at the repo root.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=eyelecture
DB_PASSWORD=eyelecture
DB_NAME=eyelecture
DB_SSL=false
DB_LOGGING=false
# Leave false. Schema changes go through migrations.
DB_SYNCHRONIZE=false

# --- JWT --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=30d

# --- App --------------------------------------------------------------------
# Used to build the links inside verification emails.
FRONTEND_URL=http://localhost:4200
EMAIL_VERIFICATION_TTL_HOURS=48

# --- Seed (npm run seed) ----------------------------------------------------
SEED_ADMIN_EMAIL=admin@eyelecture.app
SEED_ADMIN_PASSWORD=ChangeMe123!
